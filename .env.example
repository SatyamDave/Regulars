# Deploy target: development | staging | production (see docs/environments.md)
ENVIRONMENT=development

# Web / webhooks
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
BLUEBUBBLES_WEBHOOK_TOKEN=

# Database (Supabase Postgres in prod; unset = tests use SQLite)
DATABASE_URL=

# Models (see regulars/llm/factory.py for defaults)
ANTHROPIC_API_KEY=
REGULARS_SCORING_MODEL=
REGULARS_CHEAP_MODEL=
REGULARS_ENACTMENT_MODEL=
REGULARS_ENACTMENT_BASE_URL=
REGULARS_ENACTMENT_API_KEY=
